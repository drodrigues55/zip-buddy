<ContentDialog
    x:Class="ZipBuddy.UI.Views.SettingsDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Settings"
    PrimaryButtonText="Save"
    SecondaryButtonText="Apply"
    CloseButtonText="Close"
    IsSecondaryButtonEnabled="False"
    DefaultButton="Primary">

    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMaxWidth">860</x:Double>
        <x:Double x:Key="ContentDialogMaxHeight">680</x:Double>
    </ContentDialog.Resources>

    <Grid Width="780" Height="540">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <NavigationView x:Name="NavView"
                        Grid.Row="0"
                        PaneDisplayMode="Left"
                        IsPaneToggleButtonVisible="False"
                        IsBackButtonVisible="Collapsed"
                        IsSettingsVisible="False"
                        IsPaneOpen="True"
                        OpenPaneLength="210"
                        SelectionChanged="OnNavSelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem x:Name="NavExtraction" Content="Extraction" Tag="Extraction">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8B7;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="NavCompression" Content="Compression" Tag="Compression">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8B9;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="NavAppearance" Content="Appearance" Tag="Appearance">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE790;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="NavFileExplorer" Content="File Explorer" Tag="FileExplorer">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xEC50;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="NavNotifications" Content="Notifications" Tag="Notifications">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xEA8F;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="NavUpdates" Content="Updates" Tag="Updates">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE895;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="NavAdvanced" Content="Advanced" Tag="Advanced">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE713;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <Grid Margin="20,0,4,0">
                <!-- 1. Extraction Page -->
                <ScrollViewer x:Name="ExtractionPageScrollViewer"
                              Visibility="Visible"
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="14" Margin="0,0,16,16">
                        <TextBlock x:Name="ExtractionPageHeader"
                                   Text="Extraction Preferences"
                                   FontWeight="SemiBold"
                                   FontSize="22"
                                   Margin="0,2,0,8" />

                        <!-- Destination Group -->
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="16">
                            <StackPanel Spacing="10">
                                <StackPanel Spacing="2">
                                    <TextBlock x:Name="DestGroupTitle" Text="Default Destination" FontWeight="SemiBold" FontSize="14" />
                                    <TextBlock x:Name="DestGroupDesc" Text="Configure where extracted archives and items are saved."
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" TextWrapping="Wrap" />
                                </StackPanel>
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="DefaultExtractionFolderBox"
                                             PlaceholderText="Leave blank to extract next to archive" />
                                    <Button Grid.Column="1"
                                            x:Name="BrowseExtractionFolderButton"
                                            Content="Browse..."
                                            VerticalAlignment="Center"
                                            Click="OnBrowseExtractionFolderClick" />
                                </Grid>
                                <TextBlock x:Name="DestExplanationText"
                                           Text="When left blank, Zip Buddy automatically extracts into the folder containing the archive."
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0" />
                            </StackPanel>
                        </Border>

                        <!-- Opening Archives Group -->
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="16">
                            <StackPanel Spacing="10">
                                <StackPanel Spacing="2">
                                    <TextBlock x:Name="OpenGroupTitle" Text="Opening Archives" FontWeight="SemiBold" FontSize="14" />
                                    <TextBlock x:Name="OpenGroupDesc" Text="Default action when double-clicking supported archives in File Explorer."
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" TextWrapping="Wrap" />
                                </StackPanel>
                                <ComboBox x:Name="DoubleClickActionBox"
                                          HorizontalAlignment="Stretch">
                                    <ComboBoxItem x:Name="OptOpenInZipBuddy" Content="Open in Zip Buddy (Browse archive)" Tag="OpenInZipBuddy" />
                                    <ComboBoxItem x:Name="OptExtractToArchiveFolder" Content="Extract to folder with archive name [Recommended]" Tag="ExtractToArchiveFolder" />
                                    <ComboBoxItem x:Name="OptExtractToPredefinedFolder" Content="Extract to predefined folder" Tag="ExtractToPredefinedFolder" />
                                    <ComboBoxItem x:Name="OptPromptDestinationFolder" Content="Prompt for destination folder..." Tag="PromptDestinationFolder" />
                                    <ComboBoxItem x:Name="OptExtractHere" Content="Extract here (in archive's folder)" Tag="ExtractHere" />
                                </ComboBox>
                            </StackPanel>
                        </Border>

                        <!-- After Extraction Group -->
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="16">
                            <StackPanel Spacing="12">
                                <TextBlock x:Name="AfterGroupTitle" Text="Post-Extraction Actions" FontWeight="SemiBold" FontSize="14" />
                                <ToggleSwitch x:Name="OpenFolderToggle"
                                              Header="Open destination folder after extraction completes" />
                                <ToggleSwitch x:Name="DeleteArchiveToggle"
                                              Header="Delete source archive after successful extraction"
                                              Toggled="OnDeleteArchiveToggled" />
                                <InfoBar x:Name="DeleteArchiveWarning"
                                         IsOpen="False"
                                         Severity="Warning"
                                         IsClosable="False"
                                         CornerRadius="8"
                                         Margin="0,4,0,0"
                                         Message="The source archive will be permanently deleted after extraction." />
                            </StackPanel>
                        </Border>

                        <!-- Safety Group -->
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="16">
                            <StackPanel Spacing="10">
                                <TextBlock x:Name="SafetyGroupTitle" Text="Safety &amp; Overwrites" FontWeight="SemiBold" FontSize="14" />
                                <CheckBox x:Name="ConfirmOverwriteCheckBox"
                                          Content="Confirm before overwriting existing files" />
                                <CheckBox x:Name="ConfirmDeleteCheckBox"
                                          Content="Confirm before deleting items from archive" />
                            </StackPanel>
                        </Border>

                        <!-- Advanced Extraction Expander -->
                        <Expander x:Name="AdvancedExpander"
                                  HorizontalAlignment="Stretch"
                                  HorizontalContentAlignment="Stretch"
                                  CornerRadius="8">
                            <Expander.Header>
                                <StackPanel Spacing="2">
                                    <TextBlock x:Name="AdvGroupTitle" Text="Advanced Extraction Options" FontWeight="SemiBold" FontSize="14" />
                                    <TextBlock x:Name="AdvGroupSubtitle" Text="CPU thread concurrency and custom scratch location"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" TextWrapping="Wrap" />
                                </StackPanel>
                            </Expander.Header>
                            <StackPanel Spacing="14" Margin="0,8,0,4">
                                <!-- Max Threads -->
                                <StackPanel Spacing="6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="2">
                                            <TextBlock x:Name="MaxThreadsTitle" Text="Maximum extraction threads" FontWeight="Medium" FontSize="13" />
                                            <TextBlock x:Name="MaxThreadsDesc" Text="Reserved for upcoming multi-threaded extraction pipeline (current version extracts sequentially)"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <TextBlock x:Name="MaxThreadsValueText"
                                                   Grid.Column="1"
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center" />
                                    </Grid>
                                    <Slider x:Name="MaxThreadsSlider"
                                            Minimum="1"
                                            Maximum="64"
                                            StepFrequency="1"
                                            ValueChanged="OnMaxThreadsSliderValueChanged" />
                                </StackPanel>

                                <!-- Custom Temp Directory -->
                                <StackPanel Spacing="6">
                                    <TextBlock x:Name="TempDirTitle" Text="Custom temporary folder" FontWeight="Medium" FontSize="13" />
                                    <TextBlock x:Name="TempDirDesc" Text="Leave blank to use default Windows %TEMP%"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" TextWrapping="Wrap" />
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="CustomTempDirBox"
                                                 PlaceholderText="Default: Windows %TEMP%" />
                                        <Button Grid.Column="1"
                                                x:Name="BrowseTempDirButton"
                                                Content="Browse..."
                                                VerticalAlignment="Center"
                                                Click="OnBrowseTempDirClick" />
                                    </Grid>
                                </StackPanel>
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </ScrollViewer>

                <!-- 2. Compression Page -->
                <ScrollViewer x:Name="CompressionPageScrollViewer"
                              Visibility="Collapsed"
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="14" Margin="0,0,16,16">
                        <TextBlock x:Name="CompressionPageHeader"
                                   Text="Compression Preferences"
                                   FontWeight="SemiBold"
                                   FontSize="22"
                                   Margin="0,2,0,8" />

                        <!-- Format Group -->
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="16">
                            <StackPanel Spacing="10">
                                <StackPanel Spacing="2">
                                    <TextBlock x:Name="FormatGroupTitle" Text="Default Archive Format" FontWeight="SemiBold" FontSize="14" />
                                    <TextBlock x:Name="FormatGroupDesc" Text="Select the default container format used when creating new archives."
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" TextWrapping="Wrap" />
                                </StackPanel>
                                <ComboBox x:Name="DefaultFormatComboBox"
                                          HorizontalAlignment="Stretch"
                                          SelectionChanged="OnDefaultFormatSelectionChanged">
                                    <ComboBoxItem x:Name="OptFormatZip" Content="ZIP (.zip) [Recommended for compatibility]" Tag="Zip" />
                                    <ComboBoxItem x:Name="OptFormatSevenZip" Content="7-Zip (.7z) [Highest compression efficiency]" Tag="SevenZip" />
                                    <ComboBoxItem x:Name="OptFormatTar" Content="TAR (.tar) [Uncompressed packaging]" Tag="Tar" />
                                    <ComboBoxItem x:Name="OptFormatGZip" Content="GZIP (.tar.gz) [Standard UNIX tarball]" Tag="GZip" />
                                    <ComboBoxItem x:Name="OptFormatBZip2" Content="BZIP2 (.tar.bz2) [High-ratio UNIX tarball]" Tag="BZip2" />
                                </ComboBox>
                                <TextBlock x:Name="FormatExplanationText"
                                           Text="Universally supported across Windows, macOS, and Linux. Supports Deflate compression and AES-256 encryption."
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0" />
                            </StackPanel>
                        </Border>

                        <!-- Level Group -->
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="16">
                            <StackPanel Spacing="10">
                                <StackPanel Spacing="2">
                                    <TextBlock x:Name="LevelGroupTitle" Text="Default Compression Level" FontWeight="SemiBold" FontSize="14" />
                                    <TextBlock x:Name="LevelGroupDesc" Text="Balance compression ratio against CPU processing time and memory usage."
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" TextWrapping="Wrap" />
                                </StackPanel>
                                <ComboBox x:Name="DefaultLevelComboBox"
                                          HorizontalAlignment="Stretch"
                                          SelectionChanged="OnDefaultLevelSelectionChanged">
                                    <ComboBoxItem x:Name="OptLevelStore" Content="Store (No compression)" Tag="Store" />
                                    <ComboBoxItem x:Name="OptLevelFast" Content="Fast (Lowest CPU usage)" Tag="Fast" />
                                    <ComboBoxItem x:Name="OptLevelNormal" Content="Normal (Balanced speed and size) [Recommended]" Tag="Normal" />
                                    <ComboBoxItem x:Name="OptLevelMaximum" Content="Maximum (High compression)" Tag="Maximum" />
                                    <ComboBoxItem x:Name="OptLevelUltra" Content="Ultra (Smallest size, slowest)" Tag="Ultra" />
                                </ComboBox>
                                <TextBlock x:Name="LevelExplanationText"
                                           Text="Delivers the best overall balance of compression efficiency, processing speed, and memory usage. Recommended for general use."
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0" />
                            </StackPanel>
                        </Border>

                        <!-- Contextual Format / Level Guidance InfoBar -->
                        <InfoBar x:Name="FormatLimitationInfoBar"
                                 IsOpen="False"
                                 IsClosable="False"
                                 CornerRadius="8"
                                 Margin="0,4,0,0"
                                 Severity="Informational" />
                    </StackPanel>
                </ScrollViewer>

                <!-- 3. Appearance Page -->
                <ScrollViewer x:Name="AppearancePageScrollViewer"
                              Visibility="Collapsed"
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="14" Margin="0,0,16,16">
                        <TextBlock x:Name="AppearancePageHeader"
                                   Text="Appearance Preferences"
                                   FontWeight="SemiBold"
                                   FontSize="22"
                                   Margin="0,2,0,8" />

                        <!-- Theme Group -->
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="16">
                            <StackPanel Spacing="10">
                                <StackPanel Spacing="2">
                                    <TextBlock x:Name="ThemeGroupTitle" Text="Application Theme" FontWeight="SemiBold" FontSize="14" />
                                    <TextBlock x:Name="ThemeGroupDesc" Text="Choose how Zip Buddy looks on your device."
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" TextWrapping="Wrap" />
                                </StackPanel>
                                <ComboBox x:Name="ThemeComboBox"
                                          HorizontalAlignment="Stretch"
                                          SelectionChanged="OnThemeSelectionChanged">
                                    <ComboBoxItem x:Name="OptThemeSystem" Content="System default" Tag="System" />
                                    <ComboBoxItem x:Name="OptThemeLight" Content="Light" Tag="Light" />
                                    <ComboBoxItem x:Name="OptThemeDark" Content="Dark" Tag="Dark" />
                                </ComboBox>
                                <TextBlock x:Name="ThemeExplanationText"
                                           Text="Automatically adjusts between light and dark modes based on Windows settings."
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0" />
                            </StackPanel>
                        </Border>

                        <!-- Language Group -->
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="16">
                            <StackPanel Spacing="10">
                                <StackPanel Spacing="2">
                                    <TextBlock x:Name="LanguageGroupTitle" Text="Display Language" FontWeight="SemiBold" FontSize="14" />
                                    <TextBlock x:Name="LanguageGroupDesc" Text="Select your preferred language for menus, dialogs, and messages."
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" TextWrapping="Wrap" />
                                </StackPanel>
                                <ComboBox x:Name="LanguageComboBox"
                                          HorizontalAlignment="Stretch"
                                          SelectionChanged="OnLanguageSelectionChanged">
                                    <ComboBoxItem x:Name="OptLanguageSystem" Content="System default" Tag="System" />
                                    <ComboBoxItem x:Name="OptLanguageEn" Content="English (United States)" Tag="en-US" />
                                    <ComboBoxItem x:Name="OptLanguagePt" Content="Português (Brasil)" Tag="pt-BR" />
                                </ComboBox>
                                <TextBlock x:Name="LanguageExplanationText"
                                           Text="Uses the language configured in your Windows operating system."
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0" />
                            </StackPanel>
                        </Border>

                        <!-- Restart Notice InfoBar -->
                        <InfoBar x:Name="AppearanceRestartInfoBar"
                                 IsOpen="True"
                                 IsClosable="False"
                                 CornerRadius="8"
                                 Margin="0,4,0,0"
                                 Severity="Informational"
                                 Title="Restart Required"
                                 Message="Theme and language changes take full effect after restarting the application." />
                    </StackPanel>
                </ScrollViewer>

                <!-- 4. File Explorer Page -->
                <ScrollViewer x:Name="FileExplorerPageScrollViewer"
                              Visibility="Collapsed"
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="14" Margin="0,0,16,16">
                        <TextBlock x:Name="FileExplorerPageHeader"
                                   Text="File Explorer Integration"
                                   FontWeight="SemiBold"
                                   FontSize="22"
                                   Margin="0,2,0,8" />

                        <!-- Context Menu Group -->
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="16">
                            <StackPanel Spacing="12">
                                <StackPanel Spacing="2">
                                    <TextBlock x:Name="ContextMenuGroupTitle" Text="Context Menu" FontWeight="SemiBold" FontSize="14" />
                                    <TextBlock x:Name="ContextMenuGroupDesc"
                                               Text="Configure right-click options in Windows File Explorer for archives and folders."
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" TextWrapping="Wrap" />
                                </StackPanel>

                                <ToggleSwitch x:Name="ContextMenuMasterToggle"
                                              Header="Enable Windows Explorer context menu"
                                              Toggled="OnContextMenuMasterToggled" />

                                <CheckBox x:Name="CascadingMenuCheckBox"
                                          Content="Group commands into a cascading submenu (Zip Buddy >)"
                                          Margin="0,2,0,0" />

                                <!-- Commands Sub-Card with 2-Column Grid -->
                                <Border Background="{ThemeResource LayerFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="14,12"
                                        Margin="0,4,0,0">
                                    <StackPanel x:Name="ContextMenuCommandsPanel" Spacing="10">
                                        <TextBlock x:Name="CommandsListHeader" Text="Available commands" FontWeight="Medium" FontSize="13" />
                                        <Grid ColumnSpacing="16" RowSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <CheckBox Grid.Row="0" Grid.Column="0" x:Name="CmdOpenWithCheckBox" Content="Open with Zip Buddy" />
                                            <CheckBox Grid.Row="1" Grid.Column="0" x:Name="CmdExtractHereCheckBox" Content="Extract Here" />
                                            <CheckBox Grid.Row="2" Grid.Column="0" x:Name="CmdExtractToFolderCheckBox" Content="Extract to archive folder" />
                                            <CheckBox Grid.Row="0" Grid.Column="1" x:Name="CmdExtractToCheckBox" Content="Extract to..." />
                                            <CheckBox Grid.Row="1" Grid.Column="1" x:Name="CmdCompressToZipCheckBox" Content="Compress to ZIP" />
                                            <CheckBox Grid.Row="2" Grid.Column="1" x:Name="CmdCompressTo7zCheckBox" Content="Compress to 7Z" />
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- File Associations Group -->
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="16">
                            <StackPanel Spacing="12">
                                <StackPanel Spacing="2">
                                    <TextBlock x:Name="AssocGroupTitle" Text="File Associations &amp; Default App" FontWeight="SemiBold" FontSize="14" />
                                    <TextBlock x:Name="AssocGroupDesc"
                                               Text="Register Zip Buddy for supported archive formats (.zip, .7z, .rar, .tar, .gz, .bz2, .xz, and more)."
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               TextWrapping="Wrap"
                                               FontSize="12" />
                                </StackPanel>

                                <!-- Status Row with Pill Badge -->
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="2" VerticalAlignment="Center">
                                        <TextBlock x:Name="AssocStatusTitle" Text="Registration status" FontWeight="Medium" FontSize="13" />
                                        <TextBlock x:Name="AssocStatusDesc"
                                                   Text="User-level registration (HKCU) does not require administrator privileges."
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   TextWrapping="Wrap"
                                                   FontSize="12" />
                                    </StackPanel>
                                    <Border Grid.Column="1"
                                            VerticalAlignment="Center"
                                            Background="{ThemeResource LayerFillColorDefaultBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1"
                                            CornerRadius="12"
                                            Padding="12,4">
                                        <TextBlock x:Name="AssocStatusBadge"
                                                   FontSize="12"
                                                   FontWeight="SemiBold" />
                                    </Border>
                                </Grid>

                                <!-- Association Buttons: Primary Action Full Width, Secondary Split 50/50 -->
                                <Grid ColumnSpacing="8" RowSpacing="8" Margin="0,4,0,0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Primary default action -->
                                    <Button Grid.Row="0" Grid.ColumnSpan="2"
                                            x:Name="OpenDefaultAppsButton"
                                            Content="Set as Default in Windows"
                                            Style="{ThemeResource AccentButtonStyle}"
                                            HorizontalAlignment="Stretch"
                                            Click="OnOpenDefaultAppsClick" />

                                    <!-- Secondary Open-With actions -->
                                    <Button Grid.Row="1" Grid.Column="0"
                                            x:Name="RegisterAssocButton"
                                            Content="Register in Open With"
                                            HorizontalAlignment="Stretch"
                                            Click="OnRegisterAssociationsClick" />
                                    <Button Grid.Row="1" Grid.Column="1"
                                            x:Name="UnregisterAssocButton"
                                            Content="Remove from Open With"
                                            HorizontalAlignment="Stretch"
                                            Click="OnUnregisterAssociationsClick" />
                                </Grid>

                                <InfoBar x:Name="DefaultAppsInfoBar"
                                         IsOpen="True"
                                         IsClosable="False"
                                         Severity="Informational"
                                         CornerRadius="8"
                                         Margin="0,4,0,0"
                                         Title="Default Application Assignment"
                                         Message="Windows 10 and 11 require setting default file handlers in Windows Settings. Clicking 'Set as Default' opens Windows Default Apps." />
                            </StackPanel>
                        </Border>

                        <!-- Explorer Action Feedback InfoBar -->
                        <InfoBar x:Name="ExplorerActionInfoBar"
                                 IsOpen="False"
                                 IsClosable="True"
                                 CornerRadius="8"
                                 Margin="0,4,0,0" />
                    </StackPanel>
                </ScrollViewer>

                <!-- 5. Placeholder Page for Other Categories -->
                <ScrollViewer x:Name="PlaceholderPageScrollViewer"
                              Visibility="Collapsed"
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="16" Margin="0,0,16,16">
                        <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center" Margin="0,2,0,8">
                            <FontIcon x:Name="PlaceholderIcon" Glyph="&#xE8B9;" FontSize="24" />
                            <TextBlock x:Name="PlaceholderTitle" Text="Category" FontWeight="SemiBold" FontSize="22" />
                        </StackPanel>

                        <InfoBar x:Name="PlaceholderInfoBar"
                                 IsOpen="True"
                                 IsClosable="False"
                                 Severity="Informational"
                                 CornerRadius="8"
                                 Title="Under Refactoring"
                                 Message="This category will be updated in the next phase. Settings continue to function using current defaults." />

                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="16">
                            <StackPanel Spacing="8">
                                <TextBlock x:Name="PlaceholderDescTitle" Text="Settings overview" FontWeight="Medium" FontSize="14" />
                                <TextBlock x:Name="PlaceholderDescText"
                                           Text="Settings in this section are currently active with standard defaults."
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           TextWrapping="Wrap" FontSize="12" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </NavigationView>

        <!-- Status Notification -->
        <InfoBar x:Name="StatusInfoBar"
                 Grid.Row="1"
                 IsOpen="False"
                 IsClosable="True"
                 CornerRadius="8"
                 Margin="0,8,0,0" />
