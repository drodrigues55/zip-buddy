<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="ZipBuddy.UI.Views.ChecksumWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="CRC SHA — Zip Buddy"
    mc:Ignorable="d">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TitleBar x:Name="AppTitleBar" Title="CRC SHA — Zip Buddy">
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="Assets/AppIcon.ico" />
            </TitleBar.IconSource>
        </TitleBar>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Padding="24,14,24,16" Spacing="14">
                <!-- File info header -->
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE8B7;" FontSize="28" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                        <TextBlock x:Name="FileNameTextBlock" Text="Arquivo.zip" FontWeight="SemiBold" FontSize="15" TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="FileSizeTextBlock" Text="Tamanho: Calculando..." FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Grid>

                <ProgressBar x:Name="CalculationProgressBar" IsIndeterminate="True" HorizontalAlignment="Stretch" Margin="0,4,0,4" />

                <!-- Hashes Grid -->
                <Grid RowSpacing="10" ColumnSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="70" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- CRC-32 -->
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="CRC-32:" VerticalAlignment="Center" FontWeight="Medium" />
                    <TextBox x:Name="Crc32Box" Grid.Row="0" Grid.Column="1" IsReadOnly="True" FontFamily="Consolas" Text="Calculando..." />
                    <Button x:Name="CopyCrc32Button" Grid.Row="0" Grid.Column="2" Content="Copiar" Click="OnCopyCrc32Click" />

                    <!-- CRC-64 -->
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="CRC-64:" VerticalAlignment="Center" FontWeight="Medium" />
                    <TextBox x:Name="Crc64Box" Grid.Row="1" Grid.Column="1" IsReadOnly="True" FontFamily="Consolas" Text="Calculando..." />
                    <Button x:Name="CopyCrc64Button" Grid.Row="1" Grid.Column="2" Content="Copiar" Click="OnCopyCrc64Click" />

                    <!-- SHA-1 -->
                    <TextBlock Grid.Row="2" Grid.Column="0" Text="SHA-1:" VerticalAlignment="Center" FontWeight="Medium" />
                    <TextBox x:Name="Sha1Box" Grid.Row="2" Grid.Column="1" IsReadOnly="True" FontFamily="Consolas" Text="Calculando..." />
                    <Button x:Name="CopySha1Button" Grid.Row="2" Grid.Column="2" Content="Copiar" Click="OnCopySha1Click" />

                    <!-- SHA-256 -->
                    <TextBlock Grid.Row="3" Grid.Column="0" Text="SHA-256:" VerticalAlignment="Center" FontWeight="Medium" />
                    <TextBox x:Name="Sha256Box" Grid.Row="3" Grid.Column="1" IsReadOnly="True" FontFamily="Consolas" Text="Calculando..." />
                    <Button x:Name="CopySha256Button" Grid.Row="3" Grid.Column="2" Content="Copiar" Click="OnCopySha256Click" />
                </Grid>
            </StackPanel>
        </ScrollViewer>

        <!-- Bottom bar -->
        <Border Grid.Row="2" Background="{ThemeResource LayerFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Padding="20,12">
            <Grid>
                <TextBlock x:Name="StatusTextBlock" Text="Calculando hashes..." VerticalAlignment="Center" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                    <Button x:Name="CopyAllButton" Content="Copiar Tudo" Style="{ThemeResource AccentButtonStyle}" Click="OnCopyAllClick" IsEnabled="False" />
                    <Button x:Name="CloseButton" Content="Fechar" Click="OnCloseClick" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>

